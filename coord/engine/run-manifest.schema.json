{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coord/engine/run-manifest.schema.json",
  "title": "Run manifest (COORD-910, ADR 0021 decision 3)",
  "description": "A machine-verifiable record of one test-runner or gate run. INPUTS bind evidence reuse: evidence is reused only when every input matches (coord/engine/scripts/run-manifest.js check-reuse); input_digest is the sha256 of the canonical JSON of inputs. HOST facts (TMPDIR path, realpath, kernel) are recorded and compared but never bind. STACKED EVIDENCE: evidence from a top-of-stack tree is reused for an intermediate ticket only under a recorded batching ruling, and is invalid if landing changes the tested tree or base. Validated with the guard registry's JSON-schema subset plus semantic checks (digests, result vs lanes, produced artifacts).",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "tool",
    "generated_at",
    "inputs",
    "input_digest",
    "host",
    "plan",
    "evidence_policy",
    "lanes",
    "artifacts",
    "result"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "coord-run-manifest"
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "inputs": {
      "type": "object",
      "required": [
        "source",
        "tool_revision",
        "policy",
        "gate_config",
        "dependencies",
        "toolchain",
        "edition",
        "environment"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "object",
          "required": [
            "commit",
            "tree",
            "base",
            "dirty",
            "dirty_digest"
          ],
          "additionalProperties": false,
          "properties": {
            "commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "tree": {
              "type": [
                "string",
                "null"
              ]
            },
            "base": {
              "type": [
                "string",
                "null"
              ]
            },
            "dirty": {
              "type": "boolean"
            },
            "dirty_digest": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "tool_revision": {
          "type": "object",
          "required": [
            "engine_pin",
            "tool"
          ],
          "additionalProperties": false,
          "properties": {
            "engine_pin": {
              "type": [
                "string",
                "null"
              ]
            },
            "tool": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "policy": {
          "type": "object",
          "required": [
            "digest",
            "files"
          ],
          "additionalProperties": false,
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "gate_config": {
          "type": "object",
          "required": [
            "files"
          ],
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "toolchain": {
          "type": "object",
          "required": [
            "node",
            "git"
          ],
          "additionalProperties": false,
          "properties": {
            "node": {
              "type": "string",
              "minLength": 1
            },
            "git": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "edition": {
          "enum": [
            "donor",
            "Community",
            "Enterprise",
            "engine"
          ]
        },
        "environment": {
          "type": "object",
          "required": [
            "platform",
            "arch",
            "umask",
            "tmpdir_symlink",
            "tmpdir_fs_type",
            "timeouts",
            "scrubbed_env"
          ],
          "additionalProperties": false,
          "properties": {
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "arch": {
              "type": "string",
              "minLength": 1
            },
            "umask": {
              "type": "string",
              "pattern": "^[0-7]{4}$"
            },
            "tmpdir_symlink": {
              "type": "boolean"
            },
            "tmpdir_fs_type": {
              "type": "string",
              "minLength": 1
            },
            "timeouts": {
              "type": "object"
            },
            "scrubbed_env": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "host": {
      "type": "object",
      "required": [
        "tmpdir",
        "tmpdir_realpath",
        "kernel"
      ],
      "additionalProperties": false,
      "properties": {
        "tmpdir": {
          "type": "string",
          "minLength": 1
        },
        "tmpdir_realpath": {
          "type": [
            "string",
            "null"
          ]
        },
        "kernel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "shards",
        "selection"
      ],
      "additionalProperties": false,
      "properties": {
        "shards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "lane",
              "files"
            ],
            "additionalProperties": false,
            "properties": {
              "lane": {
                "type": "string",
                "minLength": 1
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "selection": {
          "type": [
            "object",
            "null"
          ],
          "description": "COORD-924: a shadow record or a landing-evidence record of a selection.",
          "required": [
            "mode",
            "authorizes_landing",
            "selector_digest",
            "base",
            "head",
            "tier",
            "categories",
            "decision",
            "fallback_reasons",
            "selected",
            "omitted",
            "missed_failures",
            "wall_time_ms"
          ],
          "properties": {
            "mode": {
              "enum": [
                "shadow",
                "landing"
              ]
            },
            "authorizes_landing": {
              "type": "boolean"
            },
            "selector_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "tier": {
              "enum": [
                "T0",
                "T1",
                "T2"
              ]
            },
            "decision": {
              "enum": [
                "selected",
                "full"
              ]
            },
            "categories": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "fallback_reasons": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "code",
                  "path",
                  "detail"
                ]
              }
            },
            "selected": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "suite",
                  "reasons"
                ]
              }
            },
            "omitted": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "suite",
                  "reason"
                ]
              }
            },
            "missed_failures": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "wall_time_ms": {
              "type": "object",
              "required": [
                "full",
                "selected",
                "saved"
              ]
            },
            "policy_version": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      }
    },
    "evidence_policy": {
      "type": "object",
      "required": [
        "stacked_reuse",
        "batching_ruling",
        "rule"
      ],
      "additionalProperties": false,
      "properties": {
        "stacked_reuse": {
          "const": "batching-ruling-required"
        },
        "batching_ruling": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "qualification": {
      "enum": [
        "provisional"
      ]
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "exit_code",
          "signal",
          "duration_ms"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "signal": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration_ms": {
            "type": "number"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "bytes": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "provisional"
      ]
    }
  }
}
