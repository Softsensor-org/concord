{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coord/board/plan.schema.json",
  "title": "Coordination Governance Plan Record",
  "type": "object",
  "required": [
    "schema_version",
    "ticket_id",
    "startup_checklist",
    "traceability_gate",
    "governance",
    "baseline_reproduction",
    "intended_files",
    "change_summary",
    "verification_commands",
    "critical_invariants",
    "requirement_closure",
    "feature_proof",
    "repo_gates",
    "self_review_cycles",
    "rollback_strategy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ticket_id": {
      "type": "string",
      "pattern": "^[A-Z]+-\\d+$"
    },
    "markdown_heading": {
      "type": "string"
    },
    "startup_checklist": {
      "type": "array",
      "items": { "type": "string" }
    },
    "traceability_gate": {
      "type": "array",
      "items": { "type": "string" }
    },
    "governance": {
      "type": "object",
      "required": ["expected_closeout", "ticket_local_repairs"],
      "properties": {
        "expected_closeout": {
          "type": "object",
          "required": ["method", "base_ref"],
          "properties": {
            "method": {
              "type": "string",
              "enum": ["pr", "no_pr", "fulfilled_by"]
            },
            "base_ref": {
              "type": "string"
            },
            "provenance_note": {
              "type": ["string", "null"]
            }
          },
          "additionalProperties": false
        },
        "review_profile": {
          "type": "string",
          "enum": ["standard", "bounded_repair"]
        },
        "ticket_local_repairs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "required_question_logged"],
            "properties": {
              "kind": { "type": "string" },
              "required_question_logged": { "type": "boolean" },
              "note": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "review_round": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "baseline_reproduction": {
      "type": "array",
      "items": { "type": "string" }
    },
    "prior_findings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scaffold_placeholders": {
      "type": "object",
      "properties": {
        "intended_files": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "intended_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "change_summary": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verification_commands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "critical_invariants": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requirement_closure": {
      "type": "array",
      "items": { "type": "string" }
    },
    "feature_proof": {
      "type": "array",
      "items": { "type": "string" }
    },
    "feature_proof_refs": {
      "description": "COORD-690: for each recorded feature proof, the named ref it actually resolved at when it was recorded. Keyed by the normalized proof entry. Makes an unreachable proof (branch/worktree-only, legitimate for unlanded repo-X work) distinguishable from one that exists nowhere, which is now refused outright.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "ref": { "type": ["string", "null"] },
          "ref_kind": { "enum": ["canonical", "branch", "worktree", "unverifiable"] },
          "sha": { "type": ["string", "null"] },
          "resolved_at": { "type": ["string", "null"] },
          "unverified_reason": { "type": ["string", "null"] }
        },
        "required": ["ref", "ref_kind"],
        "additionalProperties": false
      }
    },
    "adr_refs": {
      "description": "Optional accepted/proposed ADR references relevant to this ticket's decision surface (COORD-322).",
      "type": "array",
      "items": { "type": "string" }
    },
    "decision_required": {
      "description": "Optional decision/ADR readiness metadata for high-impact tickets (COORD-322).",
      "type": "object",
      "properties": {
        "required": { "type": "boolean" },
        "status": {
          "type": ["string", "null"],
          "enum": ["required", "not-required", "waived", "investigating", "deferred", null]
        },
        "reason": { "type": ["string", "null"] },
        "risk_class": { "type": ["string", "null"] },
        "waiver": { "type": ["string", "null"] },
        "owner": { "type": ["string", "null"] },
        "expires": { "type": ["string", "null"] },
        "adr_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "repo_gates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_supersessions": {
      "description": "Append-only correction links for repo_gates, verification_commands, and critical_invariants. Original strings remain in place; readers derive current evidence from these links.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "source_ref", "successor_ref", "reason", "actor", "timestamp"],
        "properties": {
          "id": { "type": "string", "pattern": "^pes1-[a-f0-9]{64}$" },
          "kind": { "type": "string", "enum": ["repo_gate", "verification_command", "critical_invariant"] },
          "source_ref": { "type": "string", "pattern": "^(repo_gate|verification_command|critical_invariant):[1-9][0-9]*:[a-f0-9]{64}$" },
          "successor_ref": { "type": "string", "pattern": "^(repo_gate|verification_command|critical_invariant):[1-9][0-9]*:[a-f0-9]{64}$" },
          "reason": { "type": "string", "minLength": 1 },
          "actor": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "evidence_dispositions": {
      "description": "Append-only terminal dispositions for critical invariants. The source value remains in critical_invariants history and is excluded from active projections.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "source_ref", "disposition", "reason", "actor", "timestamp"],
        "properties": {
          "id": { "type": "string", "pattern": "^ped1-[a-f0-9]{64}$" },
          "kind": { "type": "string", "const": "critical_invariant" },
          "source_ref": { "type": "string", "pattern": "^critical_invariant:[1-9][0-9]*:[a-f0-9]{64}$" },
          "disposition": { "type": "string", "const": "retracted" },
          "reason": { "type": "string", "minLength": 1 },
          "actor": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "review_submission": {
      "description": "COORD-858: immutable repository and full source commit submitted at the current move-review transition. Absent on legacy review tickets means scope is unresolved.",
      "type": "object",
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"type":"string","minLength":1,"maxLength":200,"pattern":"^(?:[A-Za-z0-9][A-Za-z0-9._/-]*|\\/[^\\u0000-\\u001f\\u007f]+|[A-Za-z]:[\\\\/][^\\u0000-\\u001f\\u007f]+|\\\\\\\\[^\\\\/\\u0000-\\u001f\\u007f]+\\\\[^\\\\/\\u0000-\\u001f\\u007f]+(?:\\\\[^\\\\/\\u0000-\\u001f\\u007f]+)*)$","not":{"anyOf":[{"pattern":"(^|[/\\\\])\\.\\.([/\\\\]|$)"},{"pattern":"^\\s|\\s$"}]}},
        "commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }
      },
      "additionalProperties": false
    },
    "independent_reviews": {
      "description": "COORD-718: append-only reviews by non-owner sessions, written only by gov record-independent-review. A review is current only when it is active (not superseded or corrected), its reviewer is not the ticket owner, and its repository and commit equal the claimed scope; everything else is history. Not self-review evidence, and QUESTIONS.md rows never substitute for it.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "review_key", "ticket_id", "reviewer", "owner_at_review", "repository", "commit", "method", "findings", "verdict", "summary", "supersedes", "corrects", "reason", "timestamp"],
        "properties": {
          "id": { "type": "string", "pattern": "^irv1-[a-f0-9]{64}$" },
          "review_key": { "type": "string", "minLength": 1, "maxLength": 300 },
          "ticket_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-\\d+$" },
          "reviewer": {
            "type": "object",
            "required": ["handle", "agent_id", "session_id", "thread_id"],
            "properties": {
              "handle": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
              "agent_id": { "type": ["string", "null"] },
              "session_id": { "type": ["string", "null"] },
              "thread_id": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "owner_at_review": { "type": ["string", "null"] },
          "repository": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
          "method": { "type": "string", "minLength": 1, "maxLength": 500 },
          "findings": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "verdict": { "type": "string", "enum": ["pass", "pass-with-findings", "fail", "inconclusive"] },
          "summary": { "type": ["string", "null"] },
          "supersedes": { "type": ["string", "null"], "pattern": "^irv1-[a-f0-9]{64}$" },
          "corrects": { "type": ["string", "null"], "pattern": "^irv1-[a-f0-9]{64}$" },
          "reason": { "type": ["string", "null"] },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "managed_execution": {
      "description": "COORD-860 (ADR-0017 slice 2): redacted managed-auto execution evidence, written only by gov record-managed-evidence. summary is the reconciliation of the local action ledger, its digest-bound declared policy, Git state and declared scope; exception is an optional human-admin technical exception bound to that exact summary (reason, named gaps, residual risk). Neither is a legal waiver or a universal observation guarantee. Absent means the ticket is unmanaged.",
      "type": "object",
      "required": ["summary", "exception", "recorded_at", "actor"],
      "properties": {
        "summary": {
          "type": "object",
          "required": ["schema", "ticket", "session", "provider", "policy_digest", "chain_root", "session_head", "base_commit", "head_commit", "integrity", "coverage", "counts", "gaps", "unexplained", "diff_digest", "verdict", "summary_digest"],
          "properties": {
            "schema": { "const": "coord.managed-execution-summary/v1" },
            "ticket": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-\\d+$" },
            "session": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
            "provider": { "type": ["string", "null"], "enum": ["claude", "codex", null] },
            "policy_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
            "chain_root": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
            "session_head": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
            "base_commit": { "type": ["string", "null"], "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
            "head_commit": { "type": ["string", "null"], "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
            "integrity": { "enum": ["valid", "invalid"] },
            "coverage": { "enum": ["complete", "partial", "interrupted", "bypassed", "unmanaged"] },
            "counts": {
              "type": "object",
              "required": ["entries", "legacy_v1", "session_events", "effects", "changed_paths", "commits", "by_class"],
              "properties": {
                "entries": { "type": "integer", "minimum": 0 },
                "legacy_v1": { "type": "integer", "minimum": 0 },
                "session_events": { "type": "integer", "minimum": 0 },
                "effects": { "type": "integer", "minimum": 0 },
                "changed_paths": { "type": "integer", "minimum": 0 },
                "commits": { "type": "integer", "minimum": 0 },
                "by_class": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
              },
              "additionalProperties": false
            },
            "gaps": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}(?::[a-z][a-z0-9_-]{0,31})?$" }, "uniqueItems": true },
            "unexplained": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}(?::[a-z][a-z0-9_-]{0,31})?$" }, "uniqueItems": true },
            "diff_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
            "verdict": { "enum": ["complete", "incomplete", "unexplained", "invalid"] },
            "summary_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "additionalProperties": false
        },
        "exception": {
          "type": ["object", "null"],
          "required": ["schema", "summary_digest", "chain_root", "gaps", "reason", "residual_risk", "approval", "actor", "recorded_at", "legal_waiver"],
          "properties": {
            "schema": { "const": "coord.managed-execution-exception/v1" },
            "summary_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "chain_root": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
            "gaps": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
            "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
            "residual_risk": { "type": "string", "minLength": 1, "maxLength": 500 },
            "approval": { "type": "string", "minLength": 1, "maxLength": 500 },
            "actor": { "type": "string", "minLength": 1 },
            "recorded_at": { "type": "string", "format": "date-time" },
            "legal_waiver": { "const": false }
          },
          "additionalProperties": false
        },
        "recorded_at": { "type": "string", "format": "date-time" },
        "actor": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "self_review_cycles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cycle", "total", "raw"],
        "properties": {
          "cycle": { "type": "integer", "minimum": 1 },
          "total": { "type": "integer", "minimum": 1 },
          "lens": { "type": ["string", "null"] },
          "diff": { "type": ["string", "null"] },
          "risks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "findings": { "type": ["string", "null"] },
          "verification": { "type": ["string", "null"] },
          "verdict": { "type": ["string", "null"] },
          "raw": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "rollback_strategy": {
      "type": "array",
      "items": { "type": "string" }
    },
    "bootstrap_risk": {
      "description": "Optional server-bootstrap / startup / backfill / derived-data risk metadata (COORD-159). Advisory only; absent on tickets that do not touch deployed startup or data-generation work. Field vocabulary is canonicalized in coord/product/SERVER_BOOTSTRAP_JOB_CONTRACT.md.",
      "type": "object",
      "properties": {
        "startup_work_class": {
          "type": "string",
          "enum": [
            "local_bootstrap",
            "deploy_bootstrap",
            "startup_work",
            "server_bootstrap_job",
            "derived_data_job",
            "production_repair"
          ]
        },
        "runs_at_boot": { "type": "boolean" },
        "shares_app_process": { "type": "boolean" },
        "resource_envelope": {
          "type": "object",
          "properties": {
            "memory_mb": { "type": ["number", "null"] },
            "timeout_s": { "type": ["number", "null"] },
            "expected_rows": { "type": ["number", "null"] },
            "batch_size": { "type": ["number", "null"] },
            "db_pool_impact": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "idempotency_strategy": { "type": ["string", "null"] },
        "checkpoint_strategy": { "type": ["string", "null"] },
        "verification_signal": { "type": ["string", "null"] },
        "rollback_or_disable": { "type": ["string", "null"] },
        "observability_requirements": {
          "type": "array",
          "items": { "type": "string" }
        },
        "data_access_shape": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "live_mcp": {
      "description": "Optional live/production-MCP operation declaration (COORD-153). PRESENCE marks the ticket as a live-mcp operation and turns on the live-MCP lifecycle enforcement gate. Operation-class policy (approval/redaction/cleanup) is sourced from coord/engine/scripts/runtime-evidence.js; see coord/engine/docs/PRODUCTION_MCP_ADAPTER_PLAN.md.",
      "type": "object",
      "properties": {
        "adapter": { "type": ["string", "null"] },
        "operation": { "type": ["string", "null"] },
        "operation_class": {
          "type": ["string", "null"],
          "enum": [
            "read_safe",
            "read_sensitive",
            "write_low",
            "write_prod",
            "destructive",
            null
          ]
        },
        "environment": {
          "type": ["string", "null"],
          "enum": ["local", "staging", "prod", null]
        },
        "scope": { "type": ["string", "null"] },
        "approval": { "type": ["string", "null"] },
        "redaction": { "type": ["string", "null"] },
        "cleanup": { "type": ["string", "null"] },
        "cleanup_required": { "type": ["boolean", "string", "null"] },
        "product_impact": { "type": ["boolean", "string", "null"] },
        "promotion": { "type": ["string", "null"] },
        "receipt_path": { "type": ["string", "null"] },
        "receipt": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    "context_pack_ack": {
      "description": "Optional structured context-pack usage acknowledgement (COORD-348). Records which memory/context sections were considered, which items were treated as authority vs advisory only, and how closeout learning should be handled.",
      "type": "object",
      "properties": {
        "refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "considered": {
          "type": "object",
          "properties": {
            "active_constraints": {
              "type": "array",
              "items": { "type": "string" }
            },
            "adrs": {
              "type": "array",
              "items": { "type": "string" }
            },
            "business_rules": {
              "type": "array",
              "items": { "type": "string" }
            },
            "conflicts": {
              "type": "array",
              "items": { "type": "string" }
            },
            "stale_warnings": {
              "type": "array",
              "items": { "type": "string" }
            },
            "open_questions": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "authority": {
          "type": "object",
          "properties": {
            "constraints": {
              "type": "array",
              "items": { "type": "string" }
            },
            "advisory_only": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "closeout_learning": {
          "type": "object",
          "properties": {
            "decision": {
              "type": ["string", "null"],
              "enum": ["promote", "demote", "scratch-only", "mixed", "none", null]
            },
            "promote": {
              "type": "array",
              "items": { "type": "string" }
            },
            "demote": {
              "type": "array",
              "items": { "type": "string" }
            },
            "scratch_only": {
              "type": "array",
              "items": { "type": "string" }
            },
            "rationale": {
              "type": ["string", "null"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "gate_plan": {
      "description": "Optional deterministic gate-plan receipt (COORD-379). Produced by gov gate-plan <ticket>; records selected/skipped gates, affected-target fallback, risk class, and required evidence. The receipt is planning evidence only and does not execute gates.",
      "type": "object",
      "additionalProperties": true
    },
    "security_surface": {
      "type": ["string", "null"]
    },
    "synced_from_markdown_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
