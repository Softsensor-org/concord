{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coord/board/tasks.schema.json",
  "title": "Coordination Board",
  "type": "object",
  "required": [
    "version",
    "metadata",
    "sections",
    "prompt_index",
    "pr_index",
    "landing_index",
    "review_findings",
    "followup_exceptions"
  ],
  "additionalProperties": false,
  "properties": {
    "landing_corrections": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z]+-\\d+$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recorded_at",
            "correction_ticket",
            "original_record_digest",
            "previous_correction_digest",
            "commit_sha",
            "source_commit_sha",
            "base_ref",
            "verified_remote_sha",
            "approval",
            "reason"
          ],
          "properties": {
            "recorded_at": {
              "type": "string",
              "minLength": 1
            },
            "correction_ticket": {
              "type": "string",
              "pattern": "^[A-Z]+-\\d+$"
            },
            "original_record_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "previous_correction_digest": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              ]
            },
            "commit_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "source_commit_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "base_ref": {
              "type": "string",
              "minLength": 1
            },
            "verified_remote_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "approval": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "last_updated",
        "canonical_references"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "last_updated": {
          "type": "string",
          "minLength": 1
        },
        "canonical_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "landing_index_required_from_ticket": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]+-\\d+$"
            },
            {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "X",
                  "B",
                  "F",
                  "default"
                ]
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Z]+-\\d+$"
              }
            }
          ]
        },
        "pr_index_required_from_ticket": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]+-\\d+$"
            },
            {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "X",
                  "B",
                  "F",
                  "default"
                ]
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Z]+-\\d+$"
              }
            }
          ]
        },
        "plan_records_required_from_ticket": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]+-\\d+$"
            },
            {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "X",
                  "B",
                  "F",
                  "default"
                ]
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Z]+-\\d+$"
              }
            }
          ]
        },
        "feature_proof_required_from_ticket": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]+-\\d+$"
            },
            {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "X",
                  "B",
                  "F",
                  "default"
                ]
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Z]+-\\d+$"
              }
            }
          ]
        },
        "plan_markdown_render_statuses": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "doing",
              "review",
              "done",
              "deferred",
              "superseded",
              "todo"
            ]
          }
        },
        "preamble": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "affected_selection": {
          "type": "object",
          "description": "COORD-924: governed affected-test selection state (activation and per-category suspensions), written only by gov selection.",
          "required": [
            "policy_version",
            "suspended_categories",
            "resolutions"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "active",
                "shadow"
              ]
            },
            "policy_version": {
              "type": [
                "integer",
                "null"
              ]
            },
            "suspended_categories": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "since",
                  "reason",
                  "ref",
                  "policy_version"
                ],
                "additionalProperties": false,
                "properties": {
                  "since": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "policy_version": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            },
            "resolutions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "category",
                  "investigation",
                  "policy_version",
                  "at"
                ],
                "additionalProperties": false,
                "properties": {
                  "category": {
                    "type": "string",
                    "minLength": 1
                  },
                  "investigation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "policy_version": {
                    "type": "integer"
                  },
                  "at": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "test_policy_exceptions": {
          "type": "object",
          "description": "COORD-936: human exceptions to the automatic test-policy selection, per ticket, written only by gov test-policy except (journaled test-policy-exception). Each is an addition or a reduction bound to the ticket's immutable submission scope, with its reason and authority (the human-admin override path).",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "ticket",
                "kind",
                "stage",
                "items",
                "reason",
                "authority",
                "scope",
                "recorded_at",
                "withdrawn_at"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "ticket": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "add",
                    "reduce"
                  ]
                },
                "stage": {
                  "type": "string",
                  "minLength": 1
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "authority": {
                  "type": "object",
                  "required": [
                    "kind",
                    "approver"
                  ],
                  "properties": {
                    "kind": {
                      "const": "human-admin-override"
                    },
                    "approver": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "scope": {
                  "type": "object",
                  "required": [
                    "commit",
                    "tree",
                    "base",
                    "files",
                    "recommended"
                  ]
                },
                "recorded_at": {
                  "type": "string",
                  "minLength": 1
                },
                "withdrawn_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "level",
          "heading",
          "separator_before"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "markdown",
              "table"
            ]
          },
          "level": {
            "type": "integer",
            "enum": [
              2,
              3
            ]
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "separator_before": {
            "type": "boolean"
          },
          "body": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Status": {
                  "type": "string",
                  "anyOf": [
                    {
                      "const": "proposed"
                    },
                    {
                      "const": "todo"
                    },
                    {
                      "const": "doing"
                    },
                    {
                      "const": "review"
                    },
                    {
                      "const": "done"
                    },
                    {
                      "const": "deferred"
                    },
                    {
                      "const": "superseded"
                    },
                    {
                      "pattern": "^doing \\(blocked: .+\\)$"
                    }
                  ]
                },
                "Superseded By": {
                  "type": "string",
                  "description": "Optional supersession provenance: the ticket ID (or short reference) that replaces this one when Status is \"superseded\". Recorded by `gov supersede --consolidated-into`/`--reason` so a retired ticket is never left without a replacement pointer."
                },
                "Supersede Reason": {
                  "type": "string",
                  "description": "Optional human-readable reason a ticket was moved to \"superseded\". Recorded by `gov supersede --reason` so supersessions carry inline provenance on the board row, not just in the event log."
                },
                "Requirement IDs": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(?:\\s*(?:[Rr][Ee][Qq]|[Uu][Rr][Ss]|[Pp][Rr][Dd]|[Ss][Rr][Ss]|[Ff][Rr]|[Nn][Ff][Rr]|[Ss][Ee][Cc]|[Dd][Oo][Nn][Oo][Rr]-[Rr][Ee][Qq])-[A-Za-z0-9_.-]*[A-Za-z0-9_](?:\\s*[,;|]\\s*(?:[Rr][Ee][Qq]|[Uu][Rr][Ss]|[Pp][Rr][Dd]|[Ss][Rr][Ss]|[Ff][Rr]|[Nn][Ff][Rr]|[Ss][Ee][Cc]|[Dd][Oo][Nn][Oo][Rr]-[Rr][Ee][Qq])-[A-Za-z0-9_.-]*[A-Za-z0-9_])*\\s*)?$"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^(?:[Rr][Ee][Qq]|[Uu][Rr][Ss]|[Pp][Rr][Dd]|[Ss][Rr][Ss]|[Ff][Rr]|[Nn][Ff][Rr]|[Ss][Ee][Cc]|[Dd][Oo][Nn][Oo][Rr]-[Rr][Ee][Qq])-[A-Za-z0-9_.-]*[A-Za-z0-9_]$"
                      }
                    }
                  ],
                  "description": "Optional explicit ticket-to-requirement links. Empty string/list means explicitly no links; missing field preserves legacy inference."
                }
              }
            }
          }
        }
      }
    },
    "prompt_index": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z]+-\\d+$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "pr_index": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z]+-\\d+$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "landing_index": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z]+-\\d+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "recorded_at",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "recorded_at": {
            "type": "string",
            "minLength": 1
          },
          "base_ref": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "enum": [
              "pr",
              "no_pr",
              "manual"
            ]
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          },
          "source_commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          },
          "pr_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requested_url",
              "url",
              "repository",
              "number",
              "base_ref",
              "state",
              "merged_at",
              "head_ref",
              "head_sha",
              "merge_sha",
              "ticket_id",
              "source_commit_sha"
            ],
            "properties": {
              "requested_url": {
                "type": "string",
                "format": "uri"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "repository": {
                "type": "string",
                "pattern": "^[^/]+/[^/]+$"
              },
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "base_ref": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "const": "MERGED"
              },
              "merged_at": {
                "type": "string",
                "minLength": 1
              },
              "head_ref": {
                "type": "string",
                "minLength": 1
              },
              "head_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "merge_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "ticket_id": {
                "type": "string",
                "pattern": "^[A-Z]+-\\d+$"
              },
              "source_commit_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          },
          "additional_pr_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/properties/landing_index/additionalProperties/properties/pr_evidence"
            }
          },
          "fulfilled_by_ticket": {
            "type": "string",
            "pattern": "^[A-Z]+-\\d+$"
          },
          "fulfilled_by_commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          },
          "provenance_status": {
            "type": "string",
            "enum": [
              "explicit",
              "legacy",
              "fulfilled_by",
              "unknown"
            ]
          },
          "control_plane_verification": {
            "type": "string",
            "enum": [
              "remote_ancestry",
              "local_only"
            ]
          },
          "control_plane_verification_reason": {
            "type": "string",
            "enum": [
              "no_control_plane_repository",
              "no_control_plane_remote",
              "no_control_plane_remote_branch",
              "no_resolvable_commit_sha"
            ]
          },
          "board_pr_landing": {
            "type": "object",
            "description": "COORD-894: the governance-only PR that published this control-plane landing commit under boardLanding \"pr\". Present only for a PR-landed closeout.",
            "required": [
              "status",
              "pr_url"
            ],
            "additionalProperties": false,
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "merged",
                  "pending",
                  "closed",
                  "failed"
                ]
              },
              "pr_url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "merge_commit_sha": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "head_branch": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "pre_closeout_push": {
            "type": "object",
            "description": "COORD-691: receipt for a governed pre-closeout push performed while recording this landing. Present only when a push actually ran; its absence means none was needed or none was authorized.",
            "required": [
              "status",
              "forced"
            ],
            "additionalProperties": false,
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "no_remote",
                  "no_remote_branch",
                  "already_present",
                  "commit_not_on_head",
                  "diverged",
                  "pushed",
                  "failed"
                ]
              },
              "pushed": {
                "type": "boolean"
              },
              "forced": {
                "type": "boolean",
                "enum": [
                  false
                ],
                "description": "A governed push never forces; the field is recorded explicitly because that is the audit question a reader has."
              },
              "ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "remote": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "remote_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "commit_sha": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "local_sha": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "remote_sha_before": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "remote_sha_after": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "created_remote_branch": {
                "type": "boolean"
              },
              "observed_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "detail": {
                "type": "string"
              },
              "attempted": {
                "type": "boolean",
                "description": "COORD-691: a push was actually invoked. Recorded separately from `pushed` because an attempt is an audit fact even when it delivered nothing."
              },
              "acknowledged": {
                "type": "boolean",
                "description": "COORD-691: whether git reported success LOCALLY. False with pushed=true means the acknowledgement was lost after the ref update reached the server."
              },
              "remote_moved": {
                "type": "boolean",
                "description": "COORD-691: the remote branch changed. Distinct from `pushed`: the remote can move without delivering the commit under test."
              },
              "ack_lost": {
                "type": "boolean",
                "description": "COORD-691: git reported failure but post-verification found the commit on the remote."
              },
              "earlier_attempt": {
                "type": "object",
                "description": "COORD-691: when this closeout performed no push and is citing one recorded in the journal, the recorded outcome of that earlier attempt, preserved verbatim. Its presence means the receipt is a citation, not a fresh push.",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "type": "string"
                  },
                  "delivered": {
                    "type": "boolean"
                  },
                  "acknowledged": {
                    "type": "boolean"
                  },
                  "ack_lost": {
                    "type": "boolean"
                  },
                  "remote_moved": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "review_findings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z]+-\\d+$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "severity",
            "summary",
            "status",
            "round",
            "qref"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Z]+-\\d+-F\\d+$"
            },
            "severity": {
              "type": "string",
              "enum": [
                "HIGH",
                "MED",
                "LOW"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "open",
                "resolved",
                "deferred",
                "consolidated"
              ]
            },
            "deferred_to": {
              "type": "string",
              "pattern": "^[A-Z]+-\\d+$"
            },
            "consolidated_into": {
              "type": "string",
              "pattern": "^[A-Z]+-\\d+-F\\d+$"
            },
            "round": {
              "type": "integer",
              "minimum": 1
            },
            "qref": {
              "type": "string"
            },
            "original_severity": {
              "type": "string",
              "enum": [
                "HIGH",
                "MED",
                "LOW"
              ]
            },
            "added_by": {
              "type": "string",
              "minLength": 1
            },
            "severity_history": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "to",
                  "direction",
                  "actor",
                  "at",
                  "reason",
                  "approval"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "enum": [
                      "HIGH",
                      "MED",
                      "LOW"
                    ]
                  },
                  "to": {
                    "type": "string",
                    "enum": [
                      "HIGH",
                      "MED",
                      "LOW"
                    ]
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "raise",
                      "lower"
                    ]
                  },
                  "actor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "at": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "approval": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "approver",
                          "reason"
                        ],
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "human-admin-override"
                            ]
                          },
                          "approver": {
                            "type": "string",
                            "minLength": 1
                          },
                          "reason": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
